+int main(void)
+{
+    TestScores();
+    TestOrdering();
+    TestFailureSet();
+    TestAllocationFailures();
+    TestMixedSelection();
+    TestProfileRelaxation();
+    TestEnumerationErrors();
+    return 0;
+}
